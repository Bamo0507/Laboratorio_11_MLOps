# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/
# Pipeline reproducible: se versionan codigo, configuracion y documentacion.
# Los CSV de entrada se versionan en este repositorio privado.
/pipeline/.venv/
/pipeline/data/processed/
/pipeline/data/interim/
/pipeline/data/tmp/

# Registros y artefactos generados por MLflow y Python.
/pipeline/mlruns/
/pipeline/mlartifacts/
/pipeline/*.db
**/__pycache__/
*.pyc
.ipynb_checkpoints/
/pipeline/data/docker/
